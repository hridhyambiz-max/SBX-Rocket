rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function founder(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='founder' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active==true;}
  match /users/{uid}{allow read: if signedIn() && (request.auth.uid==uid || founder()); allow write: if founder();}
  match /employeeLogins/{employeeId}{allow get: if signedIn(); allow list: if founder(); allow create,update,delete: if founder();}
  match /tasks/{id}{allow read,update: if signedIn(); allow create,delete: if founder();}
  match /attendance/{id}{allow read,create,update: if signedIn(); allow delete: if founder();}
  match /leaveRequests/{id}{allow read,create: if signedIn(); allow update,delete: if founder();}
  match /notifications/{id}{allow read,update: if signedIn(); allow create,delete: if founder();}
  match /payroll/{id}{allow read: if signedIn(); allow write: if founder();}
  match /payslips/{id}{allow read: if signedIn(); allow write: if founder();}
  match /rewardRequests/{id}{allow read,create: if signedIn(); allow update,delete: if founder();}
 }
}
